{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Disable all general package version updates",
      "matchPackagePatterns": ["*"],
      "enabled": false
    },
    {
      "description": "Enable PRs strictly for known vulnerabilities with automerge enabled",
      "matchDatasources": ["*"],
      "vulnerabilityAlerts": {
        "enabled": true
      },
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
