{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Disable routine version bumps for all packages",
      "matchPackagePatterns": ["*"],
      "enabled": false
    }
  ]
}
